#include <iostream>

class Listobj
{
	
	public: std::string data;
	Listobj* next;
	Listobj* prev;

	public: Listobj* getNext()
	{
		return next;
	}

	public: Listobj* getPrev()
	{
		return prev;
	}
	
	public: void UpdateNext(Listobj *node)
	{
		next = node;
	}
	public: void UpdatePrev(Listobj *node)
	{
		next = node;
	}
	
	  
		  Listobj(std::string input)
		  {
			  data = input;
			  next = nullptr;
			  prev = nullptr;

		  }


};
class ListHolder
{
	public: int size = 0;

	Listobj* head = nullptr;
	

	

	public: void Clear()
	{
		
		Listobj* CurrentNode = head;

		
		while (CurrentNode != nullptr)
		{
			Listobj* LastNode = CurrentNode;

			CurrentNode = CurrentNode-> getNext();

			size--;

			

			delete LastNode;


		}

		head = nullptr;


	}
	
	
	public:void add(Listobj* newNode)
	{
		if (size == 0)
		{
			head = newNode;
			size++;
		}
		else if(size == 1)
		{
			head->UpdateNext(newNode);
			head->UpdatePrev(newNode);

			newNode->UpdateNext(head);
			newNode->UpdatePrev(head);

			size++;

		}
		else
		{
			newNode->UpdatePrev(head->getPrev());
			newNode->UpdateNext(head);

			Listobj* OldLast = head->getPrev();

			OldLast->UpdateNext(newNode);

			head->UpdatePrev(newNode);



			size++;


		}
	
	}

	public: void Remove()
	{
		Listobj* Last = head->getPrev();
		Listobj* BeforeLast = Last->getPrev();

		head->UpdatePrev(Last->getPrev());
		BeforeLast->UpdateNext(head);

		size--;
		delete Last;
	}

	public: std::string Read(int Pos)
	{
		int Index = 0;
		Listobj* currentObj = head;
		while (Index != Pos)
		{
			currentObj = currentObj->getNext();
			Index++;
		}
		return currentObj->data;
	}
	
};

